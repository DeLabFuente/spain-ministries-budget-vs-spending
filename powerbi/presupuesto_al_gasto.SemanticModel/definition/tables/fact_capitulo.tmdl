				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"ministerio_id", Int64.Type}, {"anio", Int64.Type}, {"ambito", type text},
				        {"capitulo", Int64.Type}, {"creditos_definitivos", type number}, {"obligaciones", type number}
