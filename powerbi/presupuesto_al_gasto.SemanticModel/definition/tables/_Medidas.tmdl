table _Medidas
	lineageTag: 1bc0c374-fe3c-4fd8-8fab-da390f3e4783

	measure Iniciales =
			VAR _k = SELECTEDVALUE ( Euros[orden], 1 )
			VAR _grupos = SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[grupo_id] )
			VAR _pares =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] ),
			        dim_grupo[incluir_estado] = 1
			    )
			RETURN
			    CALCULATE ( SUMX ( fact_ministerio_anio, fact_ministerio_anio[estado_creditos_iniciales] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares, fact_ministerio_anio[anio], fact_ministerio_anio[ministerio_id] ) )
		formatString: #,0\ €
		displayFolder: 1 Presupuesto
		lineageTag: 770fce1a-a8b3-41ba-a90e-24a144009ef1

