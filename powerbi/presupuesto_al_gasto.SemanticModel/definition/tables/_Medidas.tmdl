	measure 'MRR peso en las obligaciones' = DIVIDE ( [MRR obligaciones], [Obligaciones] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		displayFolder: 3 Mecanismo de Recuperación
		lineageTag: 53b41db8-fc8c-409b-85ad-29ae13c26e10

	measure 'Obligaciones por capítulo' =
			VAR _k = SELECTEDVALUE ( Euros[orden], 1 )
			VAR _grupos = SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[grupo_id] )
			VAR _pares_estado =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] ),
			        dim_grupo[incluir_estado] = 1
			    )
			VAR _pares =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] )
			    )
			RETURN
			    CALCULATE ( SUMX ( fact_capitulo, fact_capitulo[obligaciones] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares_estado, fact_capitulo[anio], fact_capitulo[ministerio_id] ), KEEPFILTERS ( fact_capitulo[ambito] = "Estado" ) )
			        + CALCULATE ( SUMX ( fact_capitulo, fact_capitulo[obligaciones] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares, fact_capitulo[anio], fact_capitulo[ministerio_id] ), KEEPFILTERS ( fact_capitulo[ambito] <> "Estado" ) )
		formatString: #,0\ €
		displayFolder: 4 Capítulos
		lineageTag: fe11da8a-0a33-4e1d-a6be-f6b0971da2c7

	measure 'Definitivos por capítulo' =
			VAR _k = SELECTEDVALUE ( Euros[orden], 1 )
			VAR _grupos = SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[grupo_id] )
			VAR _pares_estado =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] ),
			        dim_grupo[incluir_estado] = 1
			    )
			VAR _pares =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] )
			    )
			RETURN
			    CALCULATE ( SUMX ( fact_capitulo, fact_capitulo[creditos_definitivos] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares_estado, fact_capitulo[anio], fact_capitulo[ministerio_id] ), KEEPFILTERS ( fact_capitulo[ambito] = "Estado" ) )
			        + CALCULATE ( SUMX ( fact_capitulo, fact_capitulo[creditos_definitivos] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares, fact_capitulo[anio], fact_capitulo[ministerio_id] ), KEEPFILTERS ( fact_capitulo[ambito] <> "Estado" ) )
		formatString: #,0\ €
		displayFolder: 4 Capítulos
		lineageTag: 420f4d6b-eaeb-428c-964f-32b5da6f3df0

	measure 'Sin gastar por capítulo' = [Definitivos por capítulo] - [Obligaciones por capítulo]
