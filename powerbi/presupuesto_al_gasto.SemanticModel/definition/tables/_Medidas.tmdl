	measure 'Gasto agregado' =
			VAR _k = SELECTEDVALUE ( Euros[orden], 1 )
			VAR _grupos = SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[grupo_id] )
			VAR _pares =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] )
			    )
			VAR _excluidos =
			    CALCULATETABLE (
			        SUMMARIZE ( dim_grupo, dim_grupo[anio], dim_grupo[ministerio_id] ),
			        REMOVEFILTERS ( dim_ministerio ), REMOVEFILTERS ( dim_grupo ),
			        TREATAS ( _grupos, dim_grupo[anio], dim_grupo[grupo_id] ),
			        dim_grupo[incluir_estado] = 0
			    )
			RETURN
			    CALCULATE ( SUMX ( fact_ministerio_anio, fact_ministerio_anio[gasto_agregado_sin_doble_computo] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _pares, fact_ministerio_anio[anio], fact_ministerio_anio[ministerio_id] ) )
			        - CALCULATE ( SUMX ( fact_ministerio_anio, fact_ministerio_anio[estado_obligaciones] * SWITCH ( _k, 2, RELATED ( dim_anio[factor_2025] ), 3, RELATED ( dim_anio[factor_pib] ), 4, RELATED ( dim_anio[factor_aapp] ), 1 ) ), TREATAS ( _excluidos, fact_ministerio_anio[anio], fact_ministerio_anio[ministerio_id] ) )
		formatString: #,0\ €
		displayFolder: 2 Organismos y gasto agregado
		lineageTag: 415b0d2b-7c0c-408e-8a4d-df81cbb2cf4b

